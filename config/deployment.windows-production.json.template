{
  "$schema": "../schema/deployment.schema.json",
  "schemaVersion": 1,
  "deploymentId": "browser-mcp-server-windows-prod",
  "environment": "production",
  "target": {
    "os": "windows",
    "arch": "x64"
  },
  "mode": "persistent",
  "installRoot": "C:\\ProgramData\\browser-mcp-server\\current",
  "nodeExecutable": "C:\\ProgramData\\browser-mcp-server\\current\\node\\node.exe",
  "configRoot": "C:\\ProgramData\\browser-mcp-server\\config\\prod",
  "workspaceRoots": [
    "C:\\browser-mcp-server\\Workspace"
  ],
  "output": {
    "directory": "C:\\ProgramData\\browser-mcp-server\\output\\prod",
    "maxBytes": 104857600,
    "retainSession": false,
    "retentionDays": 0
  },
  "browser": {
    "channel": "chrome",
    "userDataDir": "C:\\ProgramData\\browser-mcp-server\\profiles\\prod",
    "profileOwner": "REPLACE-ME-WINDOWS-ACCOUNT",
    "maxConcurrentAgents": 1
  },
  "network": {
    "allowedOrigins": [
      "https://REPLACE-ME.corp.example",
      "https://REPLACE-ME-SSO.corp.example"
    ],
    "enforcement": "host-firewall",
    "enforcementOwner": "REPLACE-ME-NETWORK-OWNER",
    "changeReference": "REPLACE-ME-WINDOWS-FIREWALL-CHANGE"
  },
  "dataBoundary": {
    "classification": "internal",
    "modelRoute": "REPLACE-ME-APPROVED-MODEL-ROUTE",
    "approved": false,
    "approvalReference": "REPLACE-ME-DATA-APPROVAL"
  },
  "controls": {
    "transport": "stdio",
    "humanAuthentication": true,
    "singleAgentPerProfile": true,
    "visionFallback": true,
    "devtools": false,
    "confirmationActions": [
      "delete",
      "financial-transaction",
      "production-change",
      "account-permission-change",
      "representational-communication",
      "file-upload",
      "final-submission",
      "secret-transmission"
    ]
  },
  "interaction": {
    "snapshotStrategy": "compact",
    "compatibilityMode": "robust",
    "defaultSnapshotDepth": 6
  },
  "timeouts": {
    "actionMs": 10000,
    "navigationMs": 90000,
    "settleMs": 1000
  }
}

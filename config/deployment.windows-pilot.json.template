{
  "$schema": "../schema/deployment.schema.json",
  "schemaVersion": 1,
  "deploymentId": "corp-browser-agent-windows-pilot",
  "environment": "pilot",
  "target": {
    "os": "windows",
    "arch": "x64"
  },
  "mode": "extension",
  "mcpScope": "user",
  "installRoot": "C:\\Users\\REPLACE-ME\\AppData\\Local\\IntranetBrowserAgent\\releases\\current",
  "nodeExecutable": "C:\\Users\\REPLACE-ME\\AppData\\Local\\IntranetBrowserAgent\\releases\\current\\node\\node.exe",
  "configRoot": "C:\\Users\\REPLACE-ME\\AppData\\Local\\IntranetBrowserAgent\\config\\pilot",
  "workspaceRoots": [],
  "output": {
    "directory": "C:\\Users\\REPLACE-ME\\AppData\\Local\\IntranetBrowserAgent\\output\\pilot",
    "maxBytes": 52428800,
    "retainSession": false,
    "retentionDays": 0
  },
  "browser": {
    "channel": "chrome",
    "profileOwner": "REPLACE-ME-WINDOWS-ACCOUNT",
    "maxConcurrentAgents": 1,
    "extensionDistribution": "manual-pilot",
    "manualConnectionApproval": true
  },
  "controls": {
    "transport": "stdio",
    "humanAuthentication": true,
    "singleAgentPerProfile": true,
    "visionFallback": true,
    "devtools": false,
    "confirmationActions": [
      "delete",
      "financial-transaction",
      "production-change",
      "account-permission-change",
      "representational-communication",
      "file-upload",
      "final-submission",
      "secret-transmission"
    ]
  },
  "timeouts": {
    "actionMs": 10000,
    "navigationMs": 90000,
    "settleMs": 1000
  }
}

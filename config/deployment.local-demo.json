{
  "$schema": "../schema/deployment.schema.json",
  "schemaVersion": 1,
  "deploymentId": "local-browser-agent-demo",
  "environment": "development",
  "target": {
    "os": "darwin",
    "arch": "arm64"
  },
  "mode": "persistent",
  "installRoot": "/opt/intranet-browser-agent/current",
  "configRoot": "/tmp/intranet-browser-agent-demo/config",
  "workspaceRoots": [
    "/tmp/intranet-browser-agent-demo/workspace"
  ],
  "output": {
    "directory": "/tmp/intranet-browser-agent-demo/output",
    "maxBytes": 52428800,
    "retainSession": false,
    "retentionDays": 0
  },
  "browser": {
    "channel": "chrome",
    "userDataDir": "/tmp/intranet-browser-agent-demo/chrome-profile",
    "profileOwner": "local-demo-user",
    "maxConcurrentAgents": 1
  },
  "network": {
    "allowedOrigins": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ],
    "enforcement": "loopback-only-demo",
    "enforcementOwner": "local-demo",
    "changeReference": "local-demo-only"
  },
  "dataBoundary": {
    "classification": "public-test",
    "modelRoute": "local-demo-approved-route",
    "approved": true,
    "approvalReference": "local-demo-only"
  },
  "controls": {
    "transport": "stdio",
    "humanAuthentication": true,
    "singleAgentPerProfile": true,
    "visionFallback": true,
    "devtools": false,
    "confirmationActions": [
      "delete",
      "financial-transaction",
      "production-change",
      "account-permission-change",
      "representational-communication",
      "file-upload",
      "final-submission",
      "secret-transmission"
    ]
  },
  "timeouts": {
    "actionMs": 10000,
    "navigationMs": 60000,
    "settleMs": 750
  }
}
